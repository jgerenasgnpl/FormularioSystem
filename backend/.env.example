# Variables de Entorno para FormularioSystem Backend
# Copia este archivo a .env y completa los valores

# Puerto del servidor
PORT=3000

# Credenciales de Supabase
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_SERVICE_KEY=tu-service-role-key-aqui

# Notas:
# 1. Obtén SUPABASE_URL de: Project Settings > API > Project URL
# 2. Obtén SUPABASE_SERVICE_KEY de: Project Settings > API > service_role key
# 3. NUNCA compartas el service_role key públicamente
# 4. Asegúrate de ejecutar el script SQL create_tables_system.sql antes de iniciar
